# ===========================================================================
# Cake Box – Client Environment Variables
# ===========================================================================
# Copy this file to .env (local dev) or set these in your Render dashboard
# for the FRONTEND static site.
#
# .env is git-ignored; this .env.example is safe to commit.
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION (Render frontend environment variables)
# ---------------------------------------------------------------------------

# The full URL of your Render backend Web Service.
# Do NOT include /api — it is appended automatically.
# Example: https://cake-box-api.onrender.com
VITE_API_URL=https://YOUR-BACKEND.onrender.com

# ---------------------------------------------------------------------------
# REQUIRED (both local dev and production)
# ---------------------------------------------------------------------------

# Your Supabase project URL and anon key (safe to expose to the browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
